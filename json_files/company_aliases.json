  "containerRules": {
    "filenameIgnores": [
      "repayment report",
      "bacs autopay",
      "departmental summary",
      "online receipts for invoice"
    ],
    "reports": [
      {
        "name": "Trip Stop Report",
        "require": [
          "trip stop report"
        ]
      }
    ],
    "chases": [
      {
        "name": "Chase or copy bundle",
        "matchOn": "filename",
        "anyOf": [
          "outstanding",
          "copy invoices",
          "copy invoice",
          "statement of account"
        ],
        "threshold": 1
      }
    ],
    "split": {
      "minPages": 3,
      "pageMarkerPattern": "page\\s+(\\d+)\\s*(?:of|/)\\s*\\d+",
      "invoiceNumberPatterns": [
        "[a-z]?nvoice\\s*(?:number|no\\.?|#)\\s*[:\\-~=]*\\s*([A-Z0-9][A-Z0-9\\-\\/]{2,19})",
        "inv\\s*(?:no\\.?|#)\\s*[:\\-~=]*\\s*([A-Z0-9][A-Z0-9\\-\\/]{2,19})",
        "\\b(INVOICE[\\-\\s]?\\d{2,6})\\b"
      ],
      "totalsPatterns": [
        "total\\s+due",
        "amount\\s+due",
        "balance\\s+due",
        "total\\s+payable",
        "invoice\\s+total",
        "total\\s*[£$€]?\\s*[\\d,]+\\.\\d{2}",
        "[£$€]\\s*[\\d,]+\\.\\d{2}\\s+due\\b",
        "owing\\s*[£$€]?\\s*[\\d,]+\\.\\d{2}"
      ]
    },
    "autoSendSplit": false
  }
